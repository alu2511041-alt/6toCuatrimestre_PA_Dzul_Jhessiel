// 1.-Fibonacci
function fibonacci($n) {

    $a = 0;
    $b = 1;

    echo "Serie de Fibonacci: ";

    for ($i = 0; $i < $n; $i++) {

        echo $a . " ";

        $temp = $a + $b;
        $a = $b;
        $b = $temp;
    }
}

// 2.- cadena de texto
function invertirCadena($texto) {

    $invertida = "";

    for ($i = 0; isset($texto[$i]); $i++) {
        // Solo contamos caracteres
    }

    for ($j = $i - 1; $j >= 0; $j--) {
        $invertida .= $texto[$j];
    }

    return $invertida;
}



fibonacci(10);

echo "\n\n";

$cadena = "Hola Mundo";
echo "Cadena original: " . $cadena . "\n";
echo "Cadena invertida: " . invertirCadena($cadena);

